' ') {
                onSelect(record);
              }
            }}
          >
            <span className={styles.expression}>
              {formatNumber(record.operand1)} {formatOperator(record.operator)}{' '}
              {formatNumber(record.operand2)}
            </span>
            <span className={styles.result}>= {formatNumber(record.result)}</span>
          </li>
        ))}
      </ul>
    </div>
  );
};

export default History;
</file>

<file path="src/components/History.module.css">
.container {
  margin-top: 1.5rem;
  width: 100%;
  max-width: 360px;
}

.title {
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 0.75rem;
  text-align: center;
}

.empty {
  text-align: center;
  color: var(--text-secondary);
  font-size: 0.9rem;
}

.list {
  list-style: none;
  max-height: 250px;
  overflow-y: auto;
  padding: 0;
}

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.6rem 0.8rem;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  margin-bottom: 0.5rem;
  cursor: pointer;
  transition: background-color 0.15s ease;
}

.item:hover {
  background: var(--button-bg);
}

.expression {
  color: var(--text-secondary);
  font-size: 0.9rem;
}

.result {
  color: var(--equals-bg);
  font-weight: 600;
  font-size: 0.95rem;
}
</file>

<file path="src/components/Calculator.tsx">
'use client';

import React, { useState, useEffect, useCallback } from 'react';
import Display from './Display';
import ButtonGrid from './ButtonGrid';
import History, { CalculationRecord } from './History';
import styles from './Calculator.module.css';

function calculate(a: number, operator: string, b: number): number | null {
  switch (operator) {
    case '+':
      return a + b;
    case '-':
      return a - b;
    case '*':
      return a * b;
    case '/':
      if (b === 0) return null;
      return a / b;
    default:
      return null;
  }
}

function formatDisplayOperator(op: string): string {
  switch (op) {
    case '+': return '+';
    case '-': return '−';
    case '*': return '×';
    case '/': return '÷';
    default: return op;
  }
}

const Calculator: React.FC = () => {
  const [currentInput, setCurrentInput] = useState<string>('0');
  const [previousInput, setPreviousInput] = useState<string>('');
  const [operator, setOperator] = useState<string>('');
  const [expression, setExpression] = useState<string>('');
  const [resetNext, setResetNext] = useState<boolean>(false);
  const [history, setHistory] = useState<CalculationRecord[]>([]);

  const fetchHistory = useCallback(async () => {
    try {
      const res = await fetch('/api/calculations');
      if (res.ok) {
        const data = await res.json();
        setHistory(data.calculations || []);
      }
    } catch (error) {
      console.error('Failed to fetch history:', error);
    }
  }, []);

  useEffect(() => {
    fetchHistory();
  }, [fetchHistory]);

  const saveCalculation = async (
    operand1: number,
    op: string,
    operand2: number,
    result: number
  ) => {
    try {
      await fetch('/api/calculations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ operand1, operator: op, operand2, result }),
      });
      fetchHistory();
    } catch (error) {
      console.error('Failed to save calculation:', error);
    }
  };

  const handleInput = (value: string) => {
    if (resetNext) {
      if (value === '.') {
        setCurrentInput('0.');
      } else {
        setCurrentInput(value);
      }
      setResetNext(false);
      return;
    }

    if (value === '.') {
      if (currentInput.includes('.')) return;
      setCurrentInput(currentInput + '.');
      return;
    }

    if (currentInput === '0' && value !== '.') {
      setCurrentInput(value);
    } else {
      if (currentInput.replace(/[^0-9]/g, '').length >= 15) return;
      setCurrentInput(currentInput + value);
    }
  };

  const handleOperator = (op: string) => {
    const current = parseFloat(currentInput);

    if (previousInput && operator && !resetNext) {
      const prev = parseFloat(previousInput);
      const result = calculate(prev, operator, current);
      if (result === null) {
        setCurrentInput('Error');
        setPreviousInput('');
        setOperator('');
        setExpression('');
        setResetNext(true);
        return;
      }
      const resultStr = String(result);
      setCurrentInput(resultStr);
      setPreviousInput(resultStr);
      setExpression(`${resultStr} ${formatDisplayOperator(op)}`);
    } else {
      setPreviousInput(currentInput);
      setExpression(`${currentInput} ${formatDisplayOperator(op)}`);
    }

    setOperator(op);
    setResetNext(true);
  };

  const handleEquals = () => {
    if (!operator || !previousInput) return;

    const prev = parseFloat(previousInput);
    const current = parseFloat(currentInput);
    const result = calculate(prev, operator, current);

    if (result === null) {
      setExpression(`${previousInput} ${formatDisplayOperator(operator)} ${currentInput}`);
      setCurrentInput('Error');
      setPreviousInput('');
      setOperator('');
      setResetNext(true);
      return;
    }

    const roundedResult = Math.round(result * 1e12) / 1e12;
    const resultStr = String(roundedResult);

    setExpression(
      `${previousInput} ${formatDisplayOperator(operator)} ${currentInput} =`
    );
    setCurrentInput(resultStr);

    saveCalculation(prev, operator, current, roundedResult);

    setPreviousInput('');
    setOperator('');
    setResetNext(true);
  };

  const handleClear = () => {
    setCurrentInput('0');
    setPreviousInput('');
    setOperator('');
    setExpression('');
    setResetNext(false);
  };

  const handleDelete = () => {
    if (resetNext || currentInput === 'Error') {
      setCurrentInput('0');
      setResetNext(false);
      return;
    }
    if (currentInput.length <= 1 || (currentInput.length === 2 && currentInput.startsWith('-'))) {
      setCurrentInput('0');
    } else {
      setCurrentInput(currentInput.slice(0, -1));
    }
  };

  const handleToggleSign = () => {
    if (currentInput