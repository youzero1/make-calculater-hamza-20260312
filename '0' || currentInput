/**
 * Pure calculation logic extracted for testability.
 */
export function calculate(a: number, operator: string, b: number): number | null {
  switch (operator) {
    case '+':
      return a + b;
    case '-':
      return a - b;
    case '*':
      return a * b;
    case '/':
      if (b === 0) return null;
      return a / b;
    default:
      return null;
  }
}

export function formatOperator(op: string): string {
  switch (op) {
    case '+': return '+';
    case '-': return '−';
    case '*': return '×';
    case '/': return '÷';
    default: return op;
  }
}

export function formatNumber(n: number): string {
  const str = String(n);
  if (str.length > 12) {
    return n.toPrecision(8);
  }
  return str;
}
