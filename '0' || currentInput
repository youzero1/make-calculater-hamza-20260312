import { calculate, formatOperator, formatNumber } from '@/lib/calculatorLogic';

describe('calculate', () => {
  test('adds two numbers', () => {
    expect(calculate(2, '+', 3)).toBe(5);
  });

  test('adds negative numbers', () => {
    expect(calculate(-5, '+', 3)).toBe(-2);
  });

  test('adds decimals', () => {
    expect(calculate(0.1, '+', 0.2)).toBeCloseTo(0.3);
  });

  test('subtracts two numbers', () => {
    expect(calculate(10, '-', 4)).toBe(6);
  });

  test('subtracts resulting in negative', () => {
    expect(calculate(3, '-', 10)).toBe(-7);
  });

  test('multiplies two numbers', () => {
    expect(calculate(6, '*', 7)).toBe(42);
  });

  test('multiplies by zero', () => {
    expect(calculate(100, '*', 0)).toBe(0);
  });

  test('multiplies negative numbers', () => {
    expect(calculate(-3, '*', -4)).toBe(12);
  });

  test('divides two numbers', () => {
    expect(calculate(10, '/', 2)).toBe(5);
  });

  test('divides with decimal result', () => {
    expect(calculate(1, '/', 3)).toBeCloseTo(0.3333333333);
  });

  test('returns null for division by zero', () => {
    expect(calculate(10, '/', 0)).toBeNull();
  });

  test('returns null for unknown operator', () => {
    expect(calculate(1, '^', 2)).toBeNull();
  });

  test('returns null for empty operator', () => {
    expect(calculate(1, '', 2)).toBeNull();
  });

  test('handles large numbers', () => {
    expect(calculate(1e10, '+', 1e10)).toBe(2e10);
  });

  test('handles very small numbers', () => {
    expect(calculate(1e-10, '*', 1e-10)).toBeCloseTo(1e-20);
  });
});

describe('formatOperator', () => {
  test('formats addition', () => {
    expect(formatOperator('+')).toBe('+');
  });

  test('formats subtraction to minus sign', () => {
    expect(formatOperator('-')).toBe('−');
  });

  test('formats multiplication to times sign', () => {
    expect(formatOperator('*')).toBe('×');
  });

  test('formats division to division sign', () => {
    expect(formatOperator('/')).toBe('÷');
  });

  test('returns unknown operator as-is', () => {
    expect(formatOperator('^')).toBe('^');
  });
});

describe('formatNumber', () => {
  test('formats normal number', () => {
    expect(formatNumber(42)).toBe('42');
  });

  test('formats zero', () => {
    expect(formatNumber(0)).toBe('0');
  });

  test('formats negative number', () => {
    expect(formatNumber(-5)).toBe('-5');
  });

  test('formats decimal number', () => {
    expect(formatNumber(3.14)).toBe('3.14');
  });

  test('truncates very long numbers', () => {
    const longNum = 1234567890123.456;
    const result = formatNumber(longNum);
    expect(result.length).toBeLessThanOrEqual(15);
  });

  test('formats small number normally', () => {
    expect(formatNumber(1)).toBe('1');
  });
});
