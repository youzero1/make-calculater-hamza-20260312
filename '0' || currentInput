'Error') return;
    if (currentInput.startsWith('-')) {
      setCurrentInput(currentInput.slice(1));
    } else {
      setCurrentInput('-' + currentInput);
    }
  };

  const handlePercent = () => {
    const current = parseFloat(currentInput);
    if (isNaN(current)) return;
    const result = current / 100;
    setCurrentInput(String(result));
  };

  const handleHistorySelect = (record: CalculationRecord) => {
    setCurrentInput(String(record.result));
    setPreviousInput('');
    setOperator('');
    setExpression(
      `${record.operand1} ${formatDisplayOperator(record.operator)} ${record.operand2} =`
    );
    setResetNext(true);
  };

  return (
    <div className={styles.wrapper}>
      <div className={styles.calculator}>
        <Display expression={expression} result={currentInput} />
        <ButtonGrid
          onInput={handleInput}
          onOperator={handleOperator}
          onEquals={handleEquals}
          onClear={handleClear}
          onDelete={handleDelete}
          onToggleSign={handleToggleSign}
          onPercent={handlePercent}
        />
      </div>
      <History history={history} onSelect={handleHistorySelect} />
    </div>
  );
};

export default Calculator;
</file>

